<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- 26100 is only the SDK the WinRT projection compiles against. The floor the installer
         accepts (setup.iss MinVersion) is 1607; without this the analyzer takes 26100 as the
         floor and CA1416 stops flagging APIs a Windows 10 station does not have. -->
    <SupportedOSPlatformVersion>10.0.14393.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FgScanner.App\FgScanner.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Test classes run serially. Several teardowns call SqliteConnection.ClearAllPools() to release
      the database file so their temp folder can be deleted, and that clears the pool for the WHOLE
      process — in parallel, one class's cleanup disposes a connection another class is midway
      through writing on, surfacing as an intermittent "Cannot access a disposed object:
      SQLitePCL.sqlite3". Before re-enabling parallelism, drop those ClearAllPools calls and give
      the test databases unpooled connections instead; the pooling is the only reason they exist.
    -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
