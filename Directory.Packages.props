<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- App shell -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- Scanning (LGPL-2.1 — keep as separate assemblies, never merge/single-file) -->
    <PackageVersion Include="NAPS2.Sdk" Version="1.3.0" />
    <PackageVersion Include="NAPS2.Sdk.Worker.Win32" Version="1.3.0" />
    <PackageVersion Include="NAPS2.Images.Gdi" Version="1.3.0" />
    <!-- Pdfium native binary for PDF import/render (BSD-3-Clause). -->
    <PackageVersion Include="NAPS2.Pdfium.Binaries" Version="1.3.0" />
    <!-- Tesseract 5.5 executable, Apache-2.0; shelled out per PLAN §5.5, never P/Invoked. -->
    <PackageVersion Include="NAPS2.Tesseract.Binaries" Version="1.4.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.2" />
    <!-- Gemini SDK (Apache-2.0), BYO-key only; key lives in Windows Credential Manager. -->
    <PackageVersion Include="Google.GenAI" Version="1.19.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageVersion Include="RichardSzalay.MockHttp" Version="7.1.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
    <!-- Auto-update with Ed25519-signed appcast (MIT). -->
    <PackageVersion Include="NetSparkleUpdater.SparkleUpdater" Version="3.1.0" />

    <!-- Data (PLAN §5.1: SQLite is a first-class deliverable) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />

    <!-- Index export (PLAN §5.2) -->
    <PackageVersion Include="ClosedXML" Version="0.105.0" />

    <!-- Patch-T separator detection (Apache-2.0), PLAN prompt 10 / research-5 C1 -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <PackageVersion Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />

    <!-- Testing -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="Verify.XunitV3" Version="31.28.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.8.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <!--
    Licensing guards (PLAN.md §3 avoid-list) — these packages must NEVER appear here:
    iText* (AGPL) · FluentAssertions >= 8 (commercial) · NAPS2.Images.ImageSharp (Split License)
    · EPPlus >= 5 (PolyForm Noncommercial) · Emgu.CV (GPL) · System.Data.SQLite (legacy)
  -->
</Project>
