# Normalize line endings in the repo; check out per-platform defaults
* text=auto

# Always LF
*.sh text eol=lf

# Always CRLF (Windows-only tooling)
*.bat text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.tif binary
*.tiff binary
*.db binary
