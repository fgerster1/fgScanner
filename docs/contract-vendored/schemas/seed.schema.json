{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimsstuff-contract/seed.schema.json",
  "title": "Index package seed",
  "description": "Per document: its pages (with the copied image paths), the current index decisions (latest per field+qualifier; withdrawals excluded), and the open AI suggestions. This is what FG Scanner shows Jim before he answers.",
  "type": "object",
  "required": ["documents"],
  "properties": {
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["anchorPageId", "pages", "decisions", "suggestions"],
        "properties": {
          "anchorPageId": { "type": "string", "minLength": 1 },
          "documentId": { "type": ["integer", "null"] },
          "title": { "type": ["string", "null"] },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["pageId", "image"],
              "properties": {
                "pageId": { "type": "string", "minLength": 1 },
                "image": { "type": "string", "pattern": "^images/[^\\\\]+$" }
              }
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "value"],
              "properties": {
                "field": { "type": "string", "minLength": 1 },
                "qualifier": { "type": ["string", "null"] },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["suggestionId", "field", "value"],
              "properties": {
                "suggestionId": { "type": "integer", "minimum": 1 },
                "field": { "type": "string", "minLength": 1 },
                "qualifier": { "type": ["string", "null"] },
                "value": { "type": "string" },
                "reasonQuote": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
