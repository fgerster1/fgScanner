{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimsstuff-contract/subjects.schema.json",
  "title": "Index package subject vocabulary",
  "description": "The full subject tree, soft-deleted rows included and marked inactive — an old results file's subject ids must resolve forever, so nothing is ever left out.",
  "type": "object",
  "required": ["vocabularyVersion", "subjects"],
  "properties": {
    "vocabularyVersion": { "type": "integer", "minimum": 1 },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "parentId", "active"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "parentId": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "active": { "type": "boolean" }
        }
      }
    }
  }
}
