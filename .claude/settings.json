{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build)",
      "PowerShell(dotnet build)",
      "Bash(dotnet build *)",
      "PowerShell(dotnet build *)",
      "Bash(dotnet test)",
      "PowerShell(dotnet test)",
      "Bash(dotnet test *)",
      "PowerShell(dotnet test *)",
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(git diff *)",
      "PowerShell(git diff *)",
      "Bash(git log *)",
      "PowerShell(git log *)",
      "Bash(git show *)",
      "PowerShell(git show *)",
      "Bash(git branch *)",
      "PowerShell(git branch *)",
      "Bash(git fetch)",
      "PowerShell(git fetch)",
      "Bash(git fetch origin)",
      "PowerShell(git fetch origin)",
      "Bash(git add *)",
      "PowerShell(git add *)",
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(gh pr view *)",
      "PowerShell(gh pr view *)",
      "Bash(gh pr list *)",
      "PowerShell(gh pr list *)",
      "Bash(gh pr diff *)",
      "PowerShell(gh pr diff *)",
      "Bash(gh issue view *)",
      "PowerShell(gh issue view *)",
      "Bash(gh issue list *)",
      "PowerShell(gh issue list *)",
      "Bash(gh run view *)",
      "PowerShell(gh run view *)",
      "Bash(gh run list *)",
      "PowerShell(gh run list *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.*.local)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git diff --output*)",
      "PowerShell(git diff --output*)",
      "Bash(git diff --ext-diff*)",
      "PowerShell(git diff --ext-diff*)",
      "Bash(git diff --no-index*)",
      "PowerShell(git diff --no-index*)",
      "Bash(git log --output*)",
      "PowerShell(git log --output*)",
      "Bash(git log --ext-diff*)",
      "PowerShell(git log --ext-diff*)",
      "Bash(git show --output*)",
      "PowerShell(git show --output*)",
      "Bash(git show --ext-diff*)",
      "PowerShell(git show --ext-diff*)",
      "Bash(git fetch --upload-pack*)",
      "PowerShell(git fetch --upload-pack*)",
      "Bash(git pull --upload-pack*)",
      "PowerShell(git pull --upload-pack*)",
      "Bash(git clone --upload-pack*)",
      "PowerShell(git clone --upload-pack*)",
      "Bash(git clone -u*)",
      "PowerShell(git clone -u*)",
      "Bash(git ls-remote --upload-pack*)",
      "PowerShell(git ls-remote --upload-pack*)",
      "Bash(git ls-remote -u*)",
      "PowerShell(git ls-remote -u*)"
    ]
  }
}
