<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAPS2.Tesseract.Binaries" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FgScanner.Core\FgScanner.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- English ships with the app (PLAN §5.5); other languages download on demand. -->
    <Content Include="tessdata\eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Orientation detection is not a language: without osd.traineddata the OSD page-segmentation
      mode hard-errors and auto-with-OSD silently degrades to plain auto, leaving a misfed page
      unrecoverable. It ships rather than downloads because the failure it prevents is silent.
    -->
    <Content Include="tessdata\osd.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
