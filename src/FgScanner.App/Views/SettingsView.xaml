<UserControl x:Class="FgScanner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:FgScanner.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=views:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Profiles &amp; index fields" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="New profile" Command="{Binding CreateProfileCommand}" Margin="6,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Rename" Command="{Binding RenameProfileCommand}" Margin="6,0,0,0"
                        ToolTip="Rename the selected profile to the name in the box" />
                <TextBox DockPanel.Dock="Right" Width="160" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />
            </DockPanel>

            <TextBlock Text="Custom fields (up to 12; saving creates a new schema version)" Opacity="0.7" Margin="0,0,0,4" />
            <DataGrid ItemsSource="{Binding Fields}" AutoGenerateColumns="False" CanUserAddRows="False"
                      MinHeight="140" MaxHeight="280" Margin="0,0,0,6" x:Name="FieldsGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="160" />
                    <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" Width="90"
                                            x:Name="TypeColumn" />
                    <DataGridCheckBoxColumn Header="Required" Binding="{Binding Required}" Width="70" />
                    <DataGridCheckBoxColumn Header="Sticky" Binding="{Binding Sticky}" Width="60" />
                    <DataGridTextColumn Header="Default ($(today) $(group) $(counter) $(user))" Binding="{Binding DefaultValue}" Width="220" />
                    <DataGridTextColumn Header="Choices (List; separate with ;)" Binding="{Binding Choices}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,0,0,12">
                <Button Content="Add field" Command="{Binding AddFieldCommand}" Margin="0,0,6,0" />
                <Button Content="Remove selected field"
                        Command="{Binding RemoveFieldCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=FieldsGrid}" />
            </WrapPanel>

            <TextBlock Text="Index file formats for this profile" FontWeight="SemiBold" Margin="0,0,0,4" />
            <WrapPanel Margin="0,0,0,12">
                <CheckBox Content="CSV" IsChecked="{Binding ExportCsv}" Margin="0,0,12,0" />
                <CheckBox Content="Excel (.xlsx)" IsChecked="{Binding ExportXlsx}" Margin="0,0,12,0" />
                <CheckBox Content="XML" IsChecked="{Binding ExportXml}" Margin="0,0,12,0" />
                <CheckBox Content="JSON" IsChecked="{Binding ExportJson}" Margin="0,0,12,0" />
                <TextBlock Text="CSV delimiter:" VerticalAlignment="Center" Margin="12,0,4,0" />
                <TextBox Width="30" Text="{Binding CsvDelimiter}" MaxLength="1" />
            </WrapPanel>

            <TextBlock Text="Capture policy for this profile" FontWeight="SemiBold" Margin="0,0,0,4" />
            <WrapPanel Margin="0,0,0,4">
                <CheckBox Content="Detect Patch-T separator sheets"
                          IsChecked="{Binding SeparatorDetectionEnabled}" Margin="0,0,12,0" />
                <CheckBox Content="Keep separator pages (instead of dropping them)"
                          IsChecked="{Binding KeepSeparatorPages}" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,4">
                <TextBlock Text="Blank pages:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="140" ItemsSource="{Binding BlankPolicies}" SelectedItem="{Binding BlankPolicy}" />
                <TextBlock Text="Drop = journaled and discarded · Flag = kept but excluded from OCR/AI/index · Separator = treated like a Patch-T sheet"
                           VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" TextWrapping="Wrap" MaxWidth="520" />
            </WrapPanel>
            <TextBlock Text="Both take effect only while the matching feature below is on."
                       Opacity="0.7" Margin="0,0,0,12" />

            <TextBlock Text="OCR" FontWeight="SemiBold" Margin="0,0,0,4" />
            <WrapPanel Margin="0,0,0,4">
                <CheckBox Content="Run OCR automatically on pages saved with this profile"
                          IsChecked="{Binding OcrEnabled}" Margin="0,0,12,0" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,4">
                <TextBlock Text="Languages (e.g. eng or eng+deu):" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Width="120" Text="{Binding OcrLanguages}" />
                <TextBlock Text="Installed:" VerticalAlignment="Center" Margin="16,0,4,0" Opacity="0.7" />
                <ItemsControl ItemsSource="{Binding InstalledLanguages}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,0,6,0" FontFamily="Consolas" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="Download language:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="140" ItemsSource="{Binding DownloadableLanguages}"
                          SelectedItem="{Binding LanguageToInstall}" DisplayMemberPath="DisplayName" />
                <Button Content="Download" Command="{Binding InstallLanguageCommand}" Margin="6,0,0,0" />
            </WrapPanel>

            <StackPanel Visibility="{Binding AiFeatureEnabled, Converter={x:Static views:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="AI descriptions (Gemini, your own key)" FontWeight="SemiBold" Margin="0,0,0,4" />
            <WrapPanel Margin="0,0,0,4">
                <TextBlock Text="API key:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Width="280" Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Validate &amp; store" Command="{Binding SaveApiKeyCommand}" Margin="6,0,6,0" />
                <Button Content="Clear stored key" Command="{Binding ClearApiKeyCommand}"
                        Visibility="{Binding HasStoredKey, Converter={x:Static views:BoolToVisibilityConverter.Instance}}" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,4">
                <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Width="200" Text="{Binding AiModel}" />
                <TextBlock Text="{Binding SpendText}" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.7" />
            </WrapPanel>
            <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Key stored in Windows Credential Manager, never logged. Use a paid-tier key — Google's free tier may train on submitted content." />
            </StackPanel>

            <CheckBox Content="Check for updates at startup" IsChecked="{Binding CheckForUpdates}" Margin="0,0,0,12" />

            <TextBlock Text="Trash" FontWeight="SemiBold" Margin="0,0,0,4" />
            <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="Keep deleted pages for" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Width="50" Text="{Binding RetentionDays}" />
                <TextBlock Text="days before permanent deletion." VerticalAlignment="Center" Margin="6,0,0,0" />
            </WrapPanel>

            <TextBlock Text="Profile files" FontWeight="SemiBold" Margin="0,0,0,4" />
            <WrapPanel Margin="0,0,0,12">
                <Button Content="Export selected profile…" Command="{Binding ExportProfileCommand}" Margin="0,0,6,0" />
                <Button Content="Import profile…" Command="{Binding ImportProfileCommand}" />
            </WrapPanel>

            <TextBlock Text="Features (v1.1)" FontWeight="SemiBold" Margin="0,0,0,4" />
            <StackPanel Margin="0,0,0,4">
                <CheckBox Content="Patch-T separator detection (enables the capture policy above and the separator-sheet button in Scan)"
                          IsChecked="{Binding FeaturePatchT}" Margin="0,0,0,4" />
                <CheckBox Content="Blank-page policy (enables the per-profile blank handling above)"
                          IsChecked="{Binding FeatureBlankPolicy}" Margin="0,0,0,4" />
                <CheckBox Content="Full-text search section (applies on next launch)"
                          IsChecked="{Binding FeatureSearch}" Margin="0,0,0,4" />
                <CheckBox Content="Commit hook (run a command and/or POST a webhook when a group is committed)"
                          IsChecked="{Binding FeatureCommitHook}" Margin="0,0,0,4" />
            </StackPanel>
            <Grid Margin="20,0,0,12" IsEnabled="{Binding FeatureCommitHook}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Command line:" VerticalAlignment="Center" Margin="0,0,6,4" />
                <TextBox Grid.Column="1" Text="{Binding HookCommandLine}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Text="Webhook URL:" VerticalAlignment="Center" Margin="0,0,6,4" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HookWebhookUrl}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="2" Grid.Column="1" Opacity="0.7" TextWrapping="Wrap"
                           Text="Command runs via cmd.exe in the group folder; tokens: $(group), $(dir), $(manifest). The webhook receives the index.json payload (manifest + rows). Outcomes land in the group's journal.txt." />
            </Grid>

            <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Opacity="0.6" FontSize="11" Margin="0,0,0,4"
                       Text="Gestures like Ctrl+Enter, Ctrl+Shift+Left, F5. Clear a box to unbind. Saved with the button below." />
            <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                            <TextBlock Text="{Binding Action}" Width="90" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Text="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Reset shortcuts to defaults" Command="{Binding ResetShortcutsCommand}"
                    HorizontalAlignment="Left" Margin="0,0,0,12" />

            <Button Content="Save profile &amp; settings" Command="{Binding SaveCommand}"
                    FontWeight="SemiBold" Padding="12,8" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusText}" Opacity="0.8" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
