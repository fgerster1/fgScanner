<UserControl x:Class="FgScanner.App.Views.IndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:FgScanner.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=views:IndexViewModel}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Left" Content="Open batch…" Click="OnOpenPackage"
                    Padding="14,6" IsEnabled="{Binding CanOpen}"
                    ToolTip="The batch file you downloaded from the portal (PKG-….zip)" />
            <Button DockPanel.Dock="Left" Content="Open folder…" Click="OnOpenPackageFolder"
                    Margin="6,0,0,0" Padding="14,6" IsEnabled="{Binding CanOpen}"
                    ToolTip="A batch that is already unpacked into a folder" />
            <Button DockPanel.Dock="Left" Content="Export results" Margin="6,0,0,0" Padding="14,6"
                    Command="{Binding ExportResultsCommand}"
                    IsEnabled="{Binding Package, Converter={x:Static views:NotNullToBoolConverter.Instance}}" />
            <Button DockPanel.Dock="Left" Content="Email the results file" Margin="6,0,0,0" Padding="14,6"
                    Command="{Binding EmailResultsCommand}"
                    IsEnabled="{Binding Package, Converter={x:Static views:NotNullToBoolConverter.Instance}}" />
            <Button DockPanel.Dock="Left" Content="Remove package from this computer" Margin="6,0,0,0"
                    Padding="14,6" Command="{Binding RequestDeleteCommand}"
                    IsEnabled="{Binding DeleteEnabled}"
                    ToolTip="Enabled once an export covers every current answer" />
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Open the package folder the portal exported (it contains manifest.json)." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Busy}" Value="True">
                                <Setter Property="Text" Value="Checking the package… every file is verified before anything opens." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <!-- The reader's refusal, word for word: these messages are the
             contract's own operator-facing words and are never rephrased. -->
        <Border DockPanel.Dock="Top" Background="#33D83B01" CornerRadius="4" Padding="10,8"
                Margin="0,0,0,6"
                Visibility="{Binding RefusalMessage, Converter={x:Static views:StringToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding RefusalMessage}" TextWrapping="Wrap" />
        </Border>

        <TextBlock DockPanel.Dock="Top" Opacity="0.8" Margin="0,0,0,6"
                   Text="{Binding PackageSummary}"
                   Visibility="{Binding PackageSummary, Converter={x:Static views:StringToVisibilityConverter.Instance}}" />

        <!-- Delete asks here, inside the section, where the counts are visible. -->
        <Border DockPanel.Dock="Top" Background="#55D13438" CornerRadius="4" Padding="10,8"
                Margin="0,0,0,6"
                Visibility="{Binding PendingDeleteText, Converter={x:Static views:StringToVisibilityConverter.Instance}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Padding="10,4" Margin="6,0,0,0"
                        Command="{Binding CancelDeleteCommand}" />
                <Button DockPanel.Dock="Right" Content="Yes, remove it" Padding="10,4"
                        Command="{Binding ConfirmDeleteCommand}" />
                <TextBlock Text="{Binding PendingDeleteText}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Opacity="0.8" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="{Binding ExportMessage}"
                   Visibility="{Binding ExportMessage, Converter={x:Static views:StringToVisibilityConverter.Instance}}" />

        <!-- A failed draft save means the answer on screen is NOT on disk. -->
        <Border DockPanel.Dock="Top" Background="#55D13438" CornerRadius="4" Padding="10,8"
                Margin="0,0,0,6"
                Visibility="{Binding DraftError, Converter={x:Static views:StringToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding DraftError}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>
        <Border DockPanel.Dock="Top" Background="#33808080" CornerRadius="4" Padding="10,8"
                Margin="0,0,0,6"
                Visibility="{Binding DraftNotice, Converter={x:Static views:StringToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding DraftNotice}" TextWrapping="Wrap" />
        </Border>

        <!-- Three panes Jim can widen or narrow (SPEC-2026-009 §08-4); the widths are remembered.
             The minimums keep every pane usable: 200 + 6 + 300 + 6 + 300 fits the section's 980. -->
        <Grid x:Name="PaneGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DocumentListColumn" Width="280" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="AnswerPanelColumn" Width="340" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Mouse only: a focusable splitter sat between "Open batch…" and the document list in
                 Tab order, where an arrow key resized the pane instead of moving through documents. -->
            <GridSplitter Focusable="False" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False" Cursor="SizeWE" KeyboardIncrement="20"
                          DragCompleted="OnSplitterDragCompleted"
                          ToolTip="Drag to make the document list wider or narrower"
                          AutomationProperties.Name="Resize the document list" />
            <GridSplitter Focusable="False" Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False" Cursor="SizeWE" KeyboardIncrement="20"
                          DragCompleted="OnSplitterDragCompleted"
                          ToolTip="Drag to make the answers wider or narrower"
                          AutomationProperties.Name="Resize the answer panel" />

            <!-- Seed order IS priority order; no sorting. -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Documents}"
                     SelectedItem="{Binding SelectedDocument}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Opacity="0.7" FontSize="11">
                                <Run Text="{Binding AnchorPageId, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding Pages.Count, Mode=OneWay}" />
                                <Run Text="page(s)" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="◀ Previous page"
                            Command="{Binding PreviousPageCommand}" Padding="10,4" />
                    <Button DockPanel.Dock="Right" Content="Next page ▶"
                            Command="{Binding NextPageCommand}" Padding="10,4" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding PagePositionText}"
                               VerticalAlignment="Center" Margin="10,0" Opacity="0.8" />
                </DockPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button x:Name="ZoomOutButton" Content="−" Click="OnZoomOut" Padding="10,2" Margin="0,0,4,0"
                            ToolTip="Zoom out" AutomationProperties.Name="Zoom out" />
                    <Button x:Name="ZoomInButton" Content="+" Click="OnZoomIn" Padding="10,2" Margin="0,0,4,0"
                            ToolTip="Zoom in" AutomationProperties.Name="Zoom in" />
                    <Button x:Name="FitButton" Content="Fit" Click="OnFit" Padding="8,2" Margin="0,0,4,0"
                            ToolTip="Show the whole page" AutomationProperties.Name="Fit the page" />
                    <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Opacity="0.7"
                               MinWidth="40" Margin="0,0,8,0" />
                    <Button Content="Open full size" Command="{Binding OpenPageViewerCommand}"
                            Padding="8,2" ToolTip="Or double-click the page" />
                </WrapPanel>
                <Border BorderThickness="1" BorderBrush="#33808080">
                    <!-- Ctrl+wheel zooms; an ungated wheel would steal ordinary scrolling.
                         LayoutTransform so the ScrollViewer's extent grows with the zoom. -->
                    <ScrollViewer x:Name="PageScroller"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="OnPageMouseWheel"
                                  ScrollChanged="OnPageScrollChanged">
                        <Image x:Name="PageImage"
                               Source="{Binding CurrentPageImagePath,
                                        Converter={x:Static views:PreviewImageConverter.Instance},
                                        NotifyOnTargetUpdated=True}"
                               TargetUpdated="OnPageImageChanged"
                               MouseLeftButtonDown="OnPageMouseDown"
                               Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                               ToolTip="Ctrl+wheel to zoom · double-click to open full size">
                            <Image.LayoutTransform>
                                <ScaleTransform x:Name="PageScale" ScaleX="1" ScaleY="1" />
                            </Image.LayoutTransform>
                        </Image>
                    </ScrollViewer>
                </Border>
            </DockPanel>
            <!-- An empty pane would read as a blank page. -->
            <TextBlock x:Name="ImageMissingText" Grid.Column="2" Text="Page image not found"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                       Visibility="Collapsed" />

            <!-- The answer panel: five questions, nothing auto-applies —
                 an untouched suggestion is not an answer. -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding SelectedDocument,
                    Converter={x:Static views:NotNullToBoolConverter.Instance}}">

                    <Border Background="#33D83B01" CornerRadius="4" Padding="8,6" Margin="0,0,0,6"
                            Visibility="{Binding AnswerError, Converter={x:Static views:StringToVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding AnswerError}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Suggestions" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <!-- Names with the id beside them (SPEC-2026-009 Q5): two people can share a name. -->
                    <ItemsControl ItemsSource="{Binding SuggestionRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" BorderBrush="#33808080" CornerRadius="4"
                                        Padding="8,6" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanAccept}" Value="False">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Accept"
                                                VerticalAlignment="Top" Padding="8,3" Margin="6,0,0,0"
                                                Visibility="{Binding CanAccept, Converter={x:Static views:BoolToVisibilityConverter.Instance}}"
                                                AutomationProperties.Name="{Binding AcceptName}"
                                                Command="{Binding DataContext.AcceptSuggestionCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Source}" />
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding FieldLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Source.Qualifier, Mode=OneWay}" Foreground="Gray" />
                                                <Run Text="→" />
                                                <Run Text="{Binding ValueLabel, Mode=OneWay}" />
                                                <Run Text="{Binding IdText, Mode=OneWay, StringFormat=· {0}, TargetNullValue=''}" Foreground="Gray" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding InfoText}" FontSize="11" Opacity="0.8"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding InfoText, Converter={x:Static views:StringToVisibilityConverter.Instance}}" />
                                            <TextBlock Text="{Binding Source.ReasonQuote}" TextWrapping="Wrap"
                                                       FontStyle="Italic" Opacity="0.8" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Document type" FontWeight="SemiBold" Margin="0,8,0,2" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Withdraw" Padding="8,3" Margin="6,0,0,0"
                                ToolTip="Record that the portal's document type decision was wrong (an empty answer)"
                                Command="{Binding WithdrawCommand}" CommandParameter="doc_type" />
                        <ComboBox ItemsSource="{Binding ActiveDocTypes}"
                                  SelectedItem="{Binding SelectedDocType}"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.Name="Document type" />
                    </DockPanel>

                    <TextBlock Text="Date" FontWeight="SemiBold" Margin="0,8,0,2" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Set" Padding="8,3" Margin="6,0,0,0"
                                Command="{Binding SetDateCommand}" />
                        <ComboBox DockPanel.Dock="Right" Width="80" Margin="6,0,0,0"
                                  ItemsSource="{Binding DateQualifiers}"
                                  SelectedItem="{Binding SelectedDateQualifier}"
                                  AutomationProperties.Name="Date qualifier" />
                        <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Date (yyyy-mm-dd)"
                                 ToolTip="yyyy-mm-dd — never reformatted for you" />
                    </DockPanel>

                    <StackPanel x:Name="PeopleSection">
                    <TextBlock Text="People" FontWeight="SemiBold" Margin="0,8,0,2" />
                    <!-- Search, then pick a row (SPEC-2026-009 §08-2). Typing only lists: a row is picked
                         by selecting it, and with none picked Add sends what was typed (ADR-0016). -->
                    <TextBox x:Name="PersonSearchBox"
                             Text="{Binding PersonText, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OnPersonSearchChanged"
                             AutomationProperties.Name="Search people"
                             ToolTip="Type part of a name or nickname" />
                    <DataGrid x:Name="PersonGrid" ItemsSource="{Binding PersonResults}"
                              SelectedItem="{Binding PersonToAdd}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              SelectionUnit="FullRow" HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              KeyboardNavigation.TabNavigation="Once"
                              GridLinesVisibility="Horizontal" MinHeight="60" MaxHeight="230"
                              Margin="0,4,0,0" PreviewKeyDown="OnPersonGridKeyDown"
                              PreviewMouseWheel="OnPersonGridMouseWheel"
                              AutomationProperties.Name="People found">
                        <!-- Tab leaves in one step: walking the cells re-selects each row it enters,
                             so the pick would become whoever sits last. No sorting: Also known as and
                             Roles are lists, which do not compare, and a sort set on an empty grid
                             stops later rows appearing. Star widths: an Auto column grows to its widest
                             cell and never gives the room back, and Name tells namesakes apart. -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="3*" />
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="Auto" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                            <DataGridTextColumn Header="Also known as" Width="2*"
                                                Binding="{Binding Aliases, Converter={x:Static views:JoinConverter.Instance}}" />
                            <DataGridTextColumn Header="Roles" Width="*"
                                                Binding="{Binding Roles, Converter={x:Static views:JoinConverter.Instance}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding PersonResultsNote}" FontSize="11" Opacity="0.8" Margin="0,2,0,0"
                               Visibility="{Binding PersonResultsNote, Converter={x:Static views:StringToVisibilityConverter.Instance}}" />
                    <!-- Role before Add in Tab order (§09): Add reached first stages the default role. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <ComboBox Width="110"
                                  ItemsSource="{Binding PersonQualifiers}"
                                  SelectedItem="{Binding PersonQualifierToAdd}"
                                  AutomationProperties.Name="Person role" />
                        <Button Content="Add" Padding="8,3" Margin="6,0,0,0"
                                Command="{Binding AddPersonCommand}" />
                    </StackPanel>
                    </StackPanel>
                    <TextBlock Opacity="0.7" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Click the person's row, then Add. Someone missing from the list? Type the name as the page spells it, leave every row unpicked, and click Add. Franz decides who it is; it is never added to the list without him." />

                    <TextBlock Text="Subjects" FontWeight="SemiBold" Margin="0,8,0,2" />
                    <ItemsControl ItemsSource="{Binding SubjectChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsChecked}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox Content="Key document" IsChecked="{Binding KeyFlagChecked}"
                              FontWeight="SemiBold" Margin="0,10,0,0" />

                    <TextBlock Text="Staged answers for this document" FontWeight="SemiBold"
                               Margin="0,10,0,2" />
                    <ItemsControl ItemsSource="{Binding StagedAnswerRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0"
                                            AutomationProperties.Name="Remove staged answer"
                                            Command="{Binding DataContext.RemoveStagedAnswerCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Source}" />
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding FieldLabel, Mode=OneWay}" />
                                        <Run Text="{Binding Source.Qualifier, Mode=OneWay}" Foreground="Gray" />
                                        <Run Text="{Binding ValueLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding IdText, Mode=OneWay, StringFormat=· {0}, TargetNullValue=''}" Foreground="Gray" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
