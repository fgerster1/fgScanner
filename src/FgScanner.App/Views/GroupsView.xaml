<UserControl x:Class="FgScanner.App.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:FgScanner.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=views:GroupsViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Group list -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Groups" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="Profile for new groups" Opacity="0.7" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="Name" Margin="0,2,0,2" />
                <CheckBox Content="Only this profile's groups" IsChecked="{Binding OnlyCurrentProfile}"
                          Margin="0,0,0,6"
                          ToolTip="Narrow the list below to groups created with the selected profile" />
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Create…"
                            Command="{Binding CreateGroupCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <Button Content="Open folder…" Command="{Binding OpenFolderAsGroupCommand}" Margin="0,0,3,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="3,0,0,0" />
                </UniformGrid>
                <Button Content="Process existing folder…" Command="{Binding ProcessExistingFolderCommand}" Margin="0,0,0,8"
                        ToolTip="Register a folder full of images and PDFs as a group (PLAN §5.7)" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Scan into this group"
                                  Command="{Binding PlacementTarget.DataContext.ScanIntoGroupCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Move all scans to another group…"
                                  Command="{Binding PlacementTarget.DataContext.MoveContentsCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Delete group…"
                                  Command="{Binding PlacementTarget.DataContext.DeleteGroupCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- The path matters: two groups can share a name in different parents,
                             and until now the list gave no way to tell them apart. -->
                        <StackPanel Margin="2" ToolTip="{Binding DirectoryPath}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DirectoryPath}" Opacity="0.55" FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding State}" Opacity="0.6" FontSize="11" />
                                <TextBlock Text="{Binding Profile.Name, StringFormat=' · {0}'}" Opacity="0.6"
                                           FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Detail: pending values, entry grid, commit -->
        <DockPanel Grid.Column="1" DataContext="{Binding Detail}">
            <StackPanel DockPanel.Dock="Top">
                <!--
                  A group keeps the field layout it was created with, so one created before its
                  fields were defined renders an empty pane. Saying so, with the way out attached,
                  is the difference between a data trap and a one-click fix.
                -->
                <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="4"
                        Background="#22808080" BorderBrush="#44808080" BorderThickness="1"
                        Visibility="{Binding SchemaNotice, Converter={x:Static views:StringToVisibilityConverter.Instance}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Use latest field layout"
                                Command="{Binding UseLatestFieldLayoutCommand}" Padding="10,4" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding SchemaNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Expander Header="Index values — applied to the next scan, or to existing rows with the button below"
                          IsExpanded="True" Margin="0,0,0,6"
                          Visibility="{Binding PendingFields.Count, Converter={x:Static views:CountToVisibilityConverter.Instance}}">
                    <ItemsControl ItemsSource="{Binding PendingFields}" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,12,4" Width="160">
                                    <TextBlock Text="{Binding Field.Name}" Opacity="0.7" FontSize="11" />
                                    <ContentControl Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsList}" Value="True">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <ComboBox ItemsSource="{Binding Choices}"
                                                                              SelectedItem="{Binding Value}" IsEditable="False" />
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <!--
                                                      A pre-scan value lands on every page of the
                                                      batch, so a mistyped date is a batch-wide
                                                      mistake. The picker makes one impossible.
                                                    -->
                                                    <DataTrigger Binding="{Binding IsDate}" Value="True">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <DatePicker SelectedDate="{Binding DateValue}" />
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <WrapPanel Margin="0,0,0,6"
                           Visibility="{Binding PendingFields.Count, Converter={x:Static views:CountToVisibilityConverter.Instance}}">
                    <Button Content="Apply to all rows" Command="{Binding ApplyValuesToAllRowsCommand}"
                            Padding="10,4"
                            ToolTip="Write the values above onto every row that does not already have one" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="Review &amp; Commit" Command="{Binding CommitCommand}" FontWeight="SemiBold"
                            Padding="10,6" Margin="0,0,6,0" />
                    <Button Content="Re-export index files" Command="{Binding ReexportCommand}" Padding="10,6" Margin="0,0,6,0" />
                    <Button Content="Add missed page…" Command="{Binding AddMissedPageCommand}" Padding="10,6" Margin="0,0,6,0" />
                    <Button Content="Import PDF/images…" Command="{Binding ImportFilesCommand}" Padding="10,6" Margin="0,0,6,0" />
                    <Button Content="Reconcile" Command="{Binding ReconcileCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Re-match renamed files by checksum; report rows whose files vanished" />
                    <Button Content="Re-process…" Command="{Binding ReprocessCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Selective OCR/AI re-run" />
                    <Button Content="OCR pages" Command="{Binding OcrPagesCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Recognize text on pages not yet OCRed" />
                    <Button Content="Re-OCR all" Command="{Binding ReOcrAllCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Redo OCR on every page (old .md files go to Trash)" />
                    <Button Content="AI describe" Command="{Binding DescribePagesCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Generate AI descriptions with your Gemini key (cost estimate shown first)" Visibility="{Binding AiAvailable, Converter={x:Static views:BoolToVisibilityConverter.Instance}}" />
                    <Button Content="Delete page (to Trash)" Command="{Binding DeleteSelectedCommand}" Padding="10,6" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="↶ Undo" Command="{Binding UndoCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Ctrl+Z" />
                    <Button Content="↷ Redo" Command="{Binding RedoCommand}" Padding="8,4" Margin="0,0,10,0" ToolTip="Ctrl+Y" />
                    <Button Content="⟲ 90°" Command="{Binding RotateLeftCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Rotate left" />
                    <Button Content="⟳ 90°" Command="{Binding RotateRightCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Rotate right" />
                    <Button Content="Flip" Command="{Binding FlipCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Rotate 180°" />
                    <Button Content="Angle…" Command="{Binding CustomRotateCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Custom rotation angle" />
                    <Button Content="Deskew" Command="{Binding DeskewCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Auto-straighten" />
                    <Button Content="Adjust…" Command="{Binding AdjustCommand}" Padding="8,4" Margin="0,0,10,0"
                            ToolTip="Brightness, contrast, hue, saturation, sharpen, black &amp; white, crop" />
                    <Button Content="Split ⇅" Command="{Binding SplitCommand}" CommandParameter="h" Padding="8,4" Margin="0,0,4,0" ToolTip="Split top/bottom" />
                    <Button Content="Split ⇆" Command="{Binding SplitCommand}" CommandParameter="v" Padding="8,4" Margin="0,0,4,0" ToolTip="Split left/right" />
                    <Button Content="Combine" Command="{Binding CombineWithNextCommand}" Padding="8,4" Margin="0,0,10,0" ToolTip="Combine with the next page" />
                    <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Move page up" />
                    <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Move page down" />
                    <Button Content="Reverse" Command="{Binding ReverseOrderCommand}" Padding="8,4" Margin="0,0,4,0" />
                    <Button Content="Interleave" Command="{Binding InterleaveCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Merge fronts and backs (manual duplex)" />
                    <Button Content="Deinterleave" Command="{Binding DeinterleaveCommand}" Padding="8,4" Margin="0,0,10,0" />
                    <Button Content="Export PDF…" Command="{Binding ExportPdfCommand}" Padding="8,4" Margin="0,0,4,0" />
                    <Button Content="Export images…" Command="{Binding ExportImagesCommand}" Padding="8,4" Margin="0,0,4,0" />
                    <Button Content="Print…" Command="{Binding PrintCommand}" Padding="8,4" Margin="0,0,4,0" />
                    <Button Content="Copy" Command="{Binding CopyPageCommand}" Padding="8,4" ToolTip="Copy page image to clipboard" />
                    <Button Content="Duplicates…" Command="{Binding CheckDuplicatesCommand}" Padding="8,4" Margin="4,0,0,0"
                            ToolTip="Find pages in this group that look like the same document" />
                </WrapPanel>
                <TextBlock Text="{Binding ValidationSummary}" Foreground="IndianRed"
                           TextWrapping="Wrap" Margin="0,0,0,4"
                           Visibility="{Binding ValidationSummary.Length, Converter={x:Static views:CountToVisibilityConverter.Instance}}" />
                <TextBlock Text="{Binding StatusText}" Opacity="0.8" Margin="0,0,0,6" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="EntryGrid" Grid.Column="0"
                          ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          EnableRowVirtualization="True"
                          SelectionChanged="OnGridSelectionChanged"
                          SelectionUnit="FullRow" SelectionMode="Extended">
                    <DataGrid.InputBindings>
                        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
                        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
                        <KeyBinding Modifiers="Ctrl+Shift" Key="Left" Command="{Binding RotateLeftCommand}" />
                        <KeyBinding Modifiers="Ctrl+Shift" Key="Right" Command="{Binding RotateRightCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <Trigger Property="Validation.HasError" Value="True">
                                    <Setter Property="BorderBrush" Value="IndianRed" />
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="ToolTip"
                                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
                <DockPanel Grid.Column="1" Margin="8,0,0,0">
                    <Border DockPanel.Dock="Top" Height="190" BorderBrush="Gray" BorderThickness="1"
                            ToolTip="Drag this preview to copy the page file elsewhere">
                        <Image Source="{Binding SelectedRow.ImagePath, Converter={x:Static views:ThumbnailConverter.Instance}}"
                               Stretch="Uniform" MouseMove="OnThumbnailMouseMove" />
                    </Border>

                    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                        <TextBlock Text="Folder" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedRow.Folder, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                 Padding="0" Margin="0,2,0,4"
                                 ToolTip="{Binding SelectedRow.ImagePath}" />
                        <Button Content="Open containing folder" HorizontalAlignment="Left" Padding="8,3"
                                Command="{Binding OpenContainingFolderCommand}" />
                    </StackPanel>

                    <!-- OCR text and the AI description are stored and exported but had no viewer;
                         read-only TextBoxes so the text can be selected and copied. -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="OCR text">
                            <TextBox Text="{Binding SelectedRow.OcrText, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                     Background="Transparent" FontFamily="Consolas" FontSize="11"
                                     VerticalScrollBarVisibility="Auto" />
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="AI description" Margin="0,8,0,0" MaxHeight="150">
                            <TextBox Text="{Binding SelectedRow.AiDescription, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                     Background="Transparent" FontSize="11"
                                     VerticalScrollBarVisibility="Auto" />
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
