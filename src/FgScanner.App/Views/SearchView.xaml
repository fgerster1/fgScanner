<UserControl x:Class="FgScanner.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:FgScanner.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=views:SearchViewModel}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}"
                    Padding="14,6" Margin="6,0,0,0" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="8,6">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Opacity="0.8" Margin="0,0,0,6" />
        <DataGrid ItemsSource="{Binding Hits}" SelectedItem="{Binding SelectedHit}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  MouseDoubleClick="OnResultDoubleClick">
            <DataGrid.InputBindings>
                <KeyBinding Key="Return" Command="{Binding OpenSelectedCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="150" />
                <DataGridTextColumn Header="Image" Binding="{Binding FileName}" Width="130" />
                <DataGridTextColumn Header="Matched in" Binding="{Binding Source}" Width="90" />
                <DataGridTemplateColumn Header="Snippet" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock views:SnippetHighlighter.Snippet="{Binding Snippet}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
