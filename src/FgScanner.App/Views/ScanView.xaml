<UserControl x:Class="FgScanner.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:FgScanner.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=views:ScanViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Device + profile panel -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Device" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Drivers}"
                          SelectedItem="{Binding SelectedDriver}"
                          Margin="0,0,0,6" />
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Refresh"
                            Command="{Binding RefreshDevicesCommand}" Margin="6,0,0,0" />
                    <!-- DisplayMemberPath sets what is drawn, not what is exposed: without an
                         automation name each entry announces the record's ToString, which reads
                         out as "ScanDeviceInfo { Driver = Wia, Id = … }". -->
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              AutomationProperties.Name="Scanner"
                              DisplayMemberPath="Name">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </DockPanel>

                <TextBlock Text="Profile" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBlock Text="Source" Opacity="0.7" />
                <!-- A source the scanner cannot do stays listed and disabled, with the reason under
                     the box: hiding it sends the operator hunting for a feature printed on the
                     machine, and a tooltip on a disabled item is not an answer (§05 N1).

                     The reason therefore travels three ways: as the text below, in the automation
                     name a screen reader announces, and in a tooltip that has to opt in to showing
                     on a disabled control at all. DisplayMemberPath covers none of them — it sets
                     what is drawn, and the entries were announcing this class's type name. -->
                <ComboBox ItemsSource="{Binding Sources}" SelectedValue="{Binding Source}"
                          SelectedValuePath="Source" DisplayMemberPath="Name" Margin="0,2,0,2"
                          AutomationProperties.Name="Source">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled" Value="{Binding IsSupported}" />
                            <Setter Property="ToolTip" Value="{Binding Announcement}" />
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Announcement}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <TextBlock Text="{Binding SourceWarning}" TextWrapping="Wrap" Foreground="IndianRed"
                           Margin="0,0,0,6"
                           Visibility="{Binding SourceWarning, Converter={x:Static views:StringToVisibilityConverter.Instance}}" />
                <!-- Some one-pass duplex scanners hand the backs back upside down. Off by default
                     and disabled for the other sources, where there is no back to turn over. -->
                <CheckBox Content="Turn the backs the right way up"
                          IsChecked="{Binding FlipDuplexedPages}"
                          IsEnabled="{Binding CanFlipDuplexedPages}"
                          ToolTip="For scanners that return the reverse side upside down."
                          Margin="0,0,0,6" />
                <TextBlock Text="Resolution (DPI)" Opacity="0.7" />
                <ComboBox ItemsSource="{Binding DpiChoices}" SelectedItem="{Binding Dpi}" Margin="0,2,0,6" />
                <TextBlock Text="Bit depth" Opacity="0.7" />
                <ComboBox ItemsSource="{Binding BitDepths}" SelectedItem="{Binding BitDepth}" Margin="0,2,0,6" />
                <TextBlock Text="Page size" Opacity="0.7" />
                <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Margin="0,2,0,6" />
                <TextBlock Opacity="0.7">
                    <Run Text="Brightness: " /><Run Text="{Binding Brightness}" />
                </TextBlock>
                <Slider Minimum="-1000" Maximum="1000" Value="{Binding Brightness}" TickFrequency="100" Margin="0,2,0,6" />
                <TextBlock Opacity="0.7">
                    <Run Text="Contrast: " /><Run Text="{Binding Contrast}" />
                </TextBlock>
                <Slider Minimum="-1000" Maximum="1000" Value="{Binding Contrast}" TickFrequency="100" Margin="0,2,0,10" />

                <UniformGrid Columns="2">
                    <Button Content="Scan" Command="{Binding ScanCommand}"
                            Padding="0,8" Margin="0,0,3,0" FontWeight="SemiBold" />
                    <Button Content="Cancel" Command="{Binding CancelScanCommand}"
                            Padding="0,8" Margin="3,0,0,0" />
                </UniformGrid>
                <Button Content="Batch scan…" Command="{Binding BatchScanCommand}"
                        Padding="0,8" Margin="0,6,0,0"
                        ToolTip="Several scan passes with a prompt or delay between them" />

                <!-- An annotated sheet is captured as found and again clean; neither
                     image alone reproduces the whole thing. The sequence owns the
                     NoteState value, so the operator never types one. -->
                <Button Content="Sheet with notes  (Ctrl+Shift+N)"
                        Command="{Binding ScanAnnotatedCommand}"
                        Padding="0,8" Margin="0,6,0,0"
                        ToolTip="Scan a sheet with sticky notes attached: as found, then clean" />

                <!-- Only while a sheet is part-scanned. Without it the sequence is
                     invisible: the sheet stays in hand with nothing on screen saying
                     so, and Cancel — the one control that keeps a half-pair off the
                     disk — is unreachable. -->
                <TextBlock Text="{Binding AnnotatedPrompt}" TextWrapping="Wrap"
                           FontWeight="SemiBold" Margin="0,10,0,0"
                           Visibility="{Binding AnnotatedActive, Converter={x:Static views:BoolToVisibilityConverter.Instance}}" />
                <UniformGrid Columns="2" Margin="0,6,0,0"
                             Visibility="{Binding AnnotatedActive, Converter={x:Static views:BoolToVisibilityConverter.Instance}}">
                    <Button Content="Note on its own" Command="{Binding ScanNoteFaceCommand}"
                            Padding="0,6" Margin="0,0,3,0"
                            ToolTip="Ctrl+Shift+F — for a note that cannot be read where it sat, or has writing on its back" />
                    <Button Content="Cancel sheet" Command="{Binding CancelAnnotatedCommand}"
                            Padding="0,6" Margin="3,0,0,0"
                            ToolTip="Abandon this sheet and move its captures to the Trash" />
                </UniformGrid>

                <!-- Both sides on a scanner that has no one-pass duplex: the fronts, then the
                     stack turned over, then the backs. The button carries the step, because it
                     both starts a stack and continues one. -->
                <Button Content="{Binding DuplexButtonText}" Command="{Binding ScanBothSidesCommand}"
                        Padding="0,8" Margin="0,6,0,0"
                        ToolTip="Scan the fronts, turn the whole stack over, then scan the backs" />

                <!-- Only while a stack is part-scanned, and for the same reason as the annotated
                     block above: the fronts otherwise sit in the session with nothing saying a
                     second pass is owed, the next ordinary scan quietly becomes that pass, and
                     Cancel — the one control that keeps a half-captured stack off the disk — is
                     unreachable. -->
                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding DuplexActive, Converter={x:Static views:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding DuplexPrompt}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <CheckBox Content="The backs come off the stack in reverse order"
                              IsChecked="{Binding BacksReversed}" Margin="0,6,0,0"
                              ToolTip="On if you turn the whole stack over; off if you flip it sheet by sheet" />
                    <Button Content="Cancel stack" Command="{Binding CancelDuplexCommand}"
                            Padding="0,6" Margin="0,6,0,0"
                            ToolTip="Abandon this stack and move both passes to the Recycle Bin" />
                </StackPanel>

                <Button Content="{Binding SaveTargetText}" Command="{Binding SaveToGroupCommand}"
                        Padding="0,8" Margin="0,8,0,0" />

                <Button Content="Separator sheet…" Command="{Binding SaveSeparatorSheetCommand}"
                        Padding="0,8" Margin="0,6,0,0"
                        Visibility="{Binding SeparatorSheetVisible, Converter={x:Static views:BoolToVisibilityConverter.Instance}}"
                        ToolTip="Save a printable Patch-T separator sheet (PDF)" />

                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.8" />
            </StackPanel>
        </ScrollViewer>

        <!-- Thumbnails (virtualized). Double-click or Enter checks a page full size, and Delete
             removes it, before it is saved to a group. -->
        <DockPanel Grid.Column="1">
            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left"
                    Content="Delete selected…" Command="{Binding DeleteSelectedPagesCommand}"
                    Padding="12,6" Margin="0,6,0,0"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="Move the selected scans to the Recycle Bin before they are saved (Delete). Select one or more pages first; not available while scanning." />
            <ListBox x:Name="PageList"
                     ItemsSource="{Binding Pages}"
                     SelectionMode="Extended"
                     SelectionChanged="OnPageSelectionChanged"
                     MouseDoubleClick="OnPageDoubleClick"
                     KeyDown="OnPageListKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name">
                            <Setter.Value>
                                <MultiBinding Converter="{x:Static views:PagePositionConverter.Instance}">
                                    <Binding />
                                    <Binding Path="DataContext.Pages" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    <Binding Path="DataContext.Pages.Count" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <Border BorderBrush="Gray" BorderThickness="1">
                                <Image Width="140"
                                       Source="{Binding FilePath, Converter={x:Static views:ThumbnailConverter.Instance}}"
                                       Stretch="Uniform" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static views:PagePositionConverter.Instance}">
                                        <Binding />
                                        <Binding Path="DataContext.Pages" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        <Binding Path="DataContext.Pages.Count" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
