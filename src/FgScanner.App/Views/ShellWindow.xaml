<Window x:Class="FgScanner.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FgScanner.App.Views"
        xmlns:controls="clr-namespace:FgScanner.App.Views.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=views:ShellViewModel}"
        Title="{Binding WindowTitle}"
        Width="1200" Height="760" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="OnSourceInitialized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Margin="8">
                <Button Content="Back up…" Click="OnBackupClick" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding LastBackupText}" Margin="0,4,0,10" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Opacity="0.7" />
                <Button Content="About" Click="OnAboutClick" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding VersionText}" Margin="0,6,0,0"
                           HorizontalAlignment="Center" Opacity="0.7" />
            </StackPanel>
            <ListBox Margin="8"
                     ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSection}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="12,10" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- One host for every section; ShowSection sets each section's minimum size. -->
        <controls:SectionScrollHost x:Name="SectionHost" Grid.Column="1" Margin="8" />
    </Grid>
</Window>
