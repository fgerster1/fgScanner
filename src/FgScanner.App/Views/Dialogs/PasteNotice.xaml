<Window x:Class="FgScanner.App.Views.Dialogs.PasteNotice"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FG Scanner" SizeToContent="WidthAndHeight" MaxWidth="380"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" Focusable="False"
        MouseLeftButtonUp="OnClicked">
    <!-- Not activated and not focusable: the operator's next click belongs in the mail message. -->
    <Border BorderBrush="#66808080" BorderThickness="1" Padding="16,12">
        <StackPanel>
            <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock x:Name="DetailText" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
