<Window x:Class="FgScanner.App.Views.Dialogs.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FgScanner.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=views:BackupViewModel}"
        Title="Back up FG Scanner" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        views:DialogFit.KeepOnScreen="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Copies everything on this computer — the scans and the database — to your USB stick, then checks the copy." />
            <Label Content="_Back up to:" Target="{Binding ElementName=TargetBox}" Padding="0,0,0,4" />
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Br_owse…" MinWidth="80" Margin="6,0,0,0"
                        Click="OnBrowse" IsEnabled="{Binding IsIdle}" />
                <ComboBox x:Name="TargetBox" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                          IsEnabled="{Binding IsIdle}"
                          AutomationProperties.Name="Back up to" />
            </DockPanel>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"
                       AutomationProperties.Name="Result" Margin="0,0,0,12" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back _up" IsDefault="True" MinWidth="90" Margin="0,0,6,0" Command="{Binding BackupCommand}" />
            <Button x:Name="CloseButton" Content="Close" IsCancel="True" MinWidth="80"
                    IsEnabled="{Binding IsIdle}" />
        </StackPanel>
    </Grid>
</Window>
