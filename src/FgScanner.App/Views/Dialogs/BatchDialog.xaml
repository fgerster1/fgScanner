<Window x:Class="FgScanner.App.Views.Dialogs.BatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FgScanner.App.Views"
        Title="Batch scan" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        views:DialogFit.KeepOnScreen="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Not focusable: clicking a label would otherwise take keyboard focus from the field in use. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <TextBlock Text="How should the batch run?" FontWeight="SemiBold" Margin="0,0,0,8" />
                <RadioButton x:Name="ModeSingle" Content="Single scan" IsChecked="True" Margin="0,0,0,4" />
                <RadioButton x:Name="ModePrompt" Content="Multiple scans — prompt between each" Margin="0,0,0,4" />
                <RadioButton x:Name="ModeDelay" Content="Multiple scans — fixed delay between each" Margin="0,0,0,8" />
                <WrapPanel Margin="0,0,0,4">
                    <TextBlock Text="Number of scans:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="CountBox" Width="50" Text="2" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,10" IsEnabled="{Binding ElementName=ModeDelay, Path=IsChecked}">
                    <TextBlock Text="Delay between scans (seconds):" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="DelayBox" Width="50" Text="5" />
                </WrapPanel>
                <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Pages land in the scan session; when a group is active they save to it automatically at the end." />
            </StackPanel>
        </ScrollViewer>
        <!-- After the body, so Tab reaches the fields before the buttons. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Start batch" IsDefault="True" MinWidth="90" Margin="0,0,6,0" Click="OnStart" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
