<Window x:Class="FgScanner.App.Views.Dialogs.AdjustDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust pages" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="Sliders use the NAPS2 scale: -1000 to 1000, 0 = unchanged."
                   Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10" />

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Brightness" Grid.Row="0" VerticalAlignment="Center" />
            <Slider x:Name="BrightnessSlider" Grid.Row="0" Grid.Column="1" Minimum="-1000" Maximum="1000" Value="0" TickFrequency="50" IsSnapToTickEnabled="True" />
            <TextBlock Text="{Binding ElementName=BrightnessSlider, Path=Value, StringFormat=F0}" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBlock Text="Contrast" Grid.Row="1" VerticalAlignment="Center" />
            <Slider x:Name="ContrastSlider" Grid.Row="1" Grid.Column="1" Minimum="-1000" Maximum="1000" Value="0" TickFrequency="50" IsSnapToTickEnabled="True" />
            <TextBlock Text="{Binding ElementName=ContrastSlider, Path=Value, StringFormat=F0}" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBlock Text="Hue" Grid.Row="2" VerticalAlignment="Center" />
            <Slider x:Name="HueSlider" Grid.Row="2" Grid.Column="1" Minimum="-1000" Maximum="1000" Value="0" TickFrequency="50" IsSnapToTickEnabled="True" />
            <TextBlock Text="{Binding ElementName=HueSlider, Path=Value, StringFormat=F0}" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBlock Text="Saturation" Grid.Row="3" VerticalAlignment="Center" />
            <Slider x:Name="SaturationSlider" Grid.Row="3" Grid.Column="1" Minimum="-1000" Maximum="1000" Value="0" TickFrequency="50" IsSnapToTickEnabled="True" />
            <TextBlock Text="{Binding ElementName=SaturationSlider, Path=Value, StringFormat=F0}" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBlock Text="Sharpen" Grid.Row="4" VerticalAlignment="Center" />
            <Slider x:Name="SharpenSlider" Grid.Row="4" Grid.Column="1" Minimum="-1000" Maximum="1000" Value="0" TickFrequency="50" IsSnapToTickEnabled="True" />
            <TextBlock Text="{Binding ElementName=SharpenSlider, Path=Value, StringFormat=F0}" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <CheckBox x:Name="BlackWhiteCheck" Content="Convert to black &amp; white (threshold below)" Margin="0,6,0,2" />
        <Slider x:Name="ThresholdSlider" Minimum="-1000" Maximum="1000" Value="0" TickFrequency="50" IsSnapToTickEnabled="True"
                IsEnabled="{Binding ElementName=BlackWhiteCheck, Path=IsChecked}" Margin="0,0,0,8" />

        <TextBlock Text="Crop (pixels from each edge)" Margin="0,4,0,2" />
        <UniformGrid Columns="4" Margin="0,0,0,10">
            <StackPanel Margin="0,0,6,0"><TextBlock Text="Left" Opacity="0.7" FontSize="11" /><TextBox x:Name="CropLeft" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,6,0"><TextBlock Text="Top" Opacity="0.7" FontSize="11" /><TextBox x:Name="CropTop" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,6,0"><TextBlock Text="Right" Opacity="0.7" FontSize="11" /><TextBox x:Name="CropRight" Text="0" /></StackPanel>
            <StackPanel><TextBlock Text="Bottom" Opacity="0.7" FontSize="11" /><TextBox x:Name="CropBottom" Text="0" /></StackPanel>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Apply" IsDefault="True" MinWidth="90" Margin="0,0,6,0" Click="OnApply" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
