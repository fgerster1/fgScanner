<Window x:Class="FgScanner.App.Views.Dialogs.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FgScanner.App.Views"
        Title="Welcome to FG Scanner" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        views:DialogFit.KeepOnScreen="True">
    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom" Content="Start scanning" IsDefault="True" Padding="14,8" HorizontalAlignment="Right" Click="OnStart" />
        <!-- Not focusable: clicking a label would otherwise take keyboard focus from the field in use. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <TextBlock Text="Welcome to FG Scanner" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Scan into groups, index every page with your own fields, and export CSV, Excel, XML, and JSON — all on this computer." />

                <TextBlock Text="Language" FontWeight="SemiBold" Margin="0,0,0,2" />
                <ComboBox x:Name="LanguageBox" SelectedIndex="0" Margin="0,0,0,10">
                    <ComboBoxItem Content="English" />
                </ComboBox>

                <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,2" />
                <ComboBox x:Name="ThemeBox" SelectedIndex="0" Margin="0,0,0,10">
                    <ComboBoxItem Content="Follow Windows (recommended)" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>

                <TextBlock Text="First profile" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="A profile holds your index fields and export formats. 'Default' always exists; name one for your main workflow now if you like." />
                <TextBox x:Name="ProfileNameBox" Margin="0,0,0,10" />

                <CheckBox x:Name="OpenAiSetup" Margin="0,0,0,12"
                          Content="Open the AI description setup afterwards (optional, uses your own Google key)" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
