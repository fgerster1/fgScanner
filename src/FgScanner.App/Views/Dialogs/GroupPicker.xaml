<Window x:Class="FgScanner.App.Views.Dialogs.GroupPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FgScanner.App.Views"
        Title="Move scans" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        views:DialogFit.KeepOnScreen="True">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Move" IsDefault="True" MinWidth="80" Margin="0,0,6,0" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ComboBox x:Name="GroupBox" DisplayMemberPath="Name" Margin="0,0,0,12" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
