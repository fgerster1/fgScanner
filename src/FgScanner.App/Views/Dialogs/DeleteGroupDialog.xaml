<Window x:Class="FgScanner.App.Views.Dialogs.DeleteGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete group" SizeToContent="Height" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="SemiBold" />
        <TextBlock x:Name="CountText" TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.75" />

        <RadioButton x:Name="KeepOption" GroupName="Policy" IsChecked="True" Margin="0,0,0,2"
                     Content="Remove the group only — leave every file where it is" />
        <TextBlock Text="The folder and its scans stay on disk; only FG Scanner forgets them."
                   Opacity="0.6" FontSize="11" Margin="20,0,0,8" TextWrapping="Wrap" />

        <RadioButton x:Name="MoveGroupOption" GroupName="Policy" Margin="0,0,0,2"
                     Content="Move the scans into another group" />
        <ComboBox x:Name="TargetGroupBox" DisplayMemberPath="Name" Margin="20,0,0,8"
                  IsEnabled="{Binding IsChecked, ElementName=MoveGroupOption}" />

        <RadioButton x:Name="MoveFilesOption" GroupName="Policy" Margin="0,0,0,2"
                     Content="Move the folder somewhere else on disk" />
        <DockPanel Margin="20,0,0,8" IsEnabled="{Binding IsChecked, ElementName=MoveFilesOption}">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Padding="8,2" Click="OnBrowse" />
            <TextBox x:Name="MoveToBox" />
        </DockPanel>

        <RadioButton x:Name="DeleteOption" GroupName="Policy" Margin="0,0,0,2"
                     Content="Delete the scans" />
        <TextBlock Text="The folder is moved into FG Scanner's trash folder, so it can still be recovered from disk. It does not appear in the Trash view, which holds individual pages."
                   Opacity="0.6" FontSize="11" Margin="20,0,0,12" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Delete group" IsDefault="True" MinWidth="90" Margin="0,0,6,0" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
