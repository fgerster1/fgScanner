<Window x:Class="FgScanner.App.Views.Dialogs.ExportImagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export images" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="File name pattern" FontWeight="SemiBold" Margin="0,0,0,2" />
        <TextBox x:Name="PatternBox" Text="$(group)_$(nnn)" Margin="0,0,0,2" />
        <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Tokens: $(group) $(doc) $(page) $(field:Name) $(YYYY) $(MM) $(DD) $(hh) $(mm) $(ss) $(n)…$(nnnn)" />

        <TextBlock Text="Format" FontWeight="SemiBold" Margin="0,0,0,2" />
        <ComboBox x:Name="FormatBox" SelectedIndex="1" Margin="0,0,0,8" SelectionChanged="OnFormatChanged">
            <ComboBoxItem Content="JPEG" />
            <ComboBoxItem Content="PNG" />
            <ComboBoxItem Content="TIFF" />
            <ComboBoxItem Content="BMP" />
        </ComboBox>

        <StackPanel x:Name="JpegPanel" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock Text="JPEG quality" Opacity="0.7" FontSize="11" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=QualitySlider, Path=Value, StringFormat=F0}" VerticalAlignment="Center" MinWidth="30" TextAlignment="Right" />
                <Slider x:Name="QualitySlider" Minimum="10" Maximum="100" Value="90" TickFrequency="5" IsSnapToTickEnabled="True" />
            </DockPanel>
        </StackPanel>

        <StackPanel x:Name="TiffPanel" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock Text="TIFF compression" Opacity="0.7" FontSize="11" />
            <ComboBox x:Name="TiffCompressionBox" SelectedIndex="0" Margin="0,0,0,4">
                <ComboBoxItem Content="Auto" />
                <ComboBoxItem Content="LZW" />
                <ComboBoxItem Content="CCITT G4 (black &amp; white)" />
                <ComboBoxItem Content="None" />
            </ComboBox>
            <CheckBox x:Name="MultiPageCheck" Content="Single multi-page file" IsChecked="True" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Export" IsDefault="True" MinWidth="90" Margin="0,0,6,0" Click="OnExport" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
