<Window x:Class="FgScanner.App.Views.Dialogs.DuplicateReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suspected duplicates" Width="760" Height="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock x:Name="PromptText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,0,0,8"
                   Text="Tick a row to send its second page to the Trash, where it stays recoverable. Exact matches are certain; text matches are strong; image matches are only a hint." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Delete ticked pages" IsDefault="True" MinWidth="140" Margin="0,0,6,0" Click="OnOk" />
            <Button Content="Leave everything" IsCancel="True" MinWidth="110" />
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Delete" Binding="{Binding Delete, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                <DataGridTextColumn Header="Match" Binding="{Binding Kind}" IsReadOnly="True" Width="70" />
                <DataGridTextColumn Header="Score" Binding="{Binding ScoreText}" IsReadOnly="True" Width="60" />
                <DataGridTextColumn Header="Keep" Binding="{Binding Keep}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Delete this one" Binding="{Binding Remove}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
