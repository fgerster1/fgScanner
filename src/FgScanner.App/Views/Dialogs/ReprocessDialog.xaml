<Window x:Class="FgScanner.App.Views.Dialogs.ReprocessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FgScanner.App.Views"
        Title="Re-process pages" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        views:DialogFit.KeepOnScreen="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Not focusable: clicking a label would otherwise take keyboard focus from the field in use. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <TextBlock Text="Which pages should be processed?" FontWeight="SemiBold" Margin="0,0,0,8" />
                <RadioButton x:Name="ScopeAll" Content="Everything still missing (OCR not done + AI not done)"
                             IsChecked="True" Margin="0,0,0,4" />
                <RadioButton x:Name="ScopeOcr" Content="Only pages without OCR (OCRed = No or Failed)" Margin="0,0,0,4" />
                <RadioButton x:Name="ScopeAi" Content="Only pages without a description (AI Failed or Pending)" Margin="0,0,0,4" />
                <RadioButton x:Name="ScopeRedo" Content="Redo everything (previous .md files go to Trash)" Margin="0,0,0,10" />
                <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="AI runs only start when a Gemini key is stored, and always show a cost estimate first." />
            </StackPanel>
        </ScrollViewer>
        <!-- After the body, so Tab reaches the fields before the buttons. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Start" IsDefault="True" MinWidth="90" Margin="0,0,6,0" Click="OnStart" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
