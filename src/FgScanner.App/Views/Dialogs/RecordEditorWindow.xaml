<Window x:Class="FgScanner.App.Views.Dialogs.RecordEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FgScanner.App.Views"
        Title="{Binding Group.Name, StringFormat='Record editor — {0}'}"
        Width="1280" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        views:DialogFit.KeepOnScreen="True"
        Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
    <!-- A modal window does not receive the main window's shortcuts, so it declares its own (§05 N8). -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="PageDown" Command="{Binding NextPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="PageUp" Command="{Binding PreviousPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!--
          One template for every field: the label, then the four possible inputs stacked in the same
          cell with only the one for this field's type visible. Kept in a single template rather than
          nested ones so AutomationProperties.LabeledBy can still name the label beside it.
        -->
        <DataTemplate x:Key="FormFieldTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FormLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="FieldLabel" Grid.Row="0" Grid.Column="0" Text="{Binding Label}"
                           Margin="0,5,8,0" VerticalAlignment="Top" />

                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding IsEditable}"
                         views:TextLengthGuard.Limit="{Binding MaxLength}"
                         AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}"
                         Visibility="{Binding IsPlainText, Converter={x:Static views:BoolToVisibilityConverter.Instance}}" />

                <!-- The memo box is sized by its grip, not by its character limit: width and length
                     are independent (§05 N4). AcceptsReturn is False — no line breaks are stored
                     (§05 Q3) — so Enter moves to the next field instead of doing nothing. -->
                <Grid Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"
                      Visibility="{Binding IsMemo, Converter={x:Static views:BoolToVisibilityConverter.Instance}}">
                    <TextBox Loaded="OnMemoBoxLoaded" Unloaded="OnMemoBoxUnloaded" KeyDown="OnMemoKeyDown"
                             Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding IsEditable}"
                             views:TextLengthGuard.Limit="{Binding MaxLength}"
                             AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}"
                             AcceptsReturn="False" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinWidth="120" MinHeight="40" Padding="2,1" />
                    <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12"
                           Margin="0,0,2,2" Cursor="SizeNWSE"
                           DragDelta="OnMemoResize" DragCompleted="OnMemoResizeCompleted"
                           ToolTip="Drag to resize this box">
                        <Thumb.Template>
                            <!-- Always visible, not on hover (§09): a grip nobody can see is not a handle. -->
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="#66808080" CornerRadius="2" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>

                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding Choices}" SelectedItem="{Binding ListValue}" IsEditable="False"
                          IsEnabled="{Binding IsEditable}"
                          AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}"
                          Visibility="{Binding IsList, Converter={x:Static views:BoolToVisibilityConverter.Instance}}" />

                <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding DateValue}"
                            IsEnabled="{Binding IsEditable}"
                            AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}"
                            Visibility="{Binding IsDate, Converter={x:Static views:BoolToVisibilityConverter.Instance}}" />

                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Error}" Foreground="IndianRed"
                           TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding Error, Converter={x:Static views:StringToVisibilityConverter.Instance}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12" KeyboardNavigation.TabNavigation="Local">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" KeyboardNavigation.TabIndex="3">
            <Button Content="◀ Previous" Command="{Binding PreviousPageCommand}" Padding="10,4" Margin="0,0,4,0"
                    ToolTip="Ctrl+PageUp" />
            <TextBlock Text="{Binding PagePosition}" VerticalAlignment="Center" MinWidth="110"
                       TextAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
            <Button Content="Next ▶" Command="{Binding NextPageCommand}" Padding="10,4" Margin="0,0,16,0"
                    ToolTip="Ctrl+PageDown" />

            <Button Content="↶ Undo" Command="{Binding UndoCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Ctrl+Z" />
            <Button Content="↷ Redo" Command="{Binding RedoCommand}" Padding="8,4" Margin="0,0,16,0" ToolTip="Ctrl+Y" />

            <Button Content="Add missed page…" Command="{Binding AddMissedPageCommand}" Padding="10,4" Margin="0,0,4,0" />
            <Button Content="Import PDF/images…" Command="{Binding ImportFilesCommand}" Padding="10,4" Margin="0,0,16,0" />
            <Button Content="Delete page (to Trash)" Command="{Binding DeletePageCommand}" Padding="10,4"
                    ToolTip="Delete — the page is restorable from the Trash for 30 days" />
        </WrapPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Close" IsCancel="True" Padding="14,4" DockPanel.Dock="Right" TabIndex="4" />
            <TextBlock Text="{Binding StatusText}" Opacity="0.8" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid x:Name="PaneGrid">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="440" MinHeight="200" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <Grid x:Name="TopGrid" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FormColumn" Width="520" MinWidth="200" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!-- Both scrollbars: 16 fields on the station's screen do not fit, and a memo box
                     dragged wider than the pane must still be reachable. -->
                <ScrollViewer x:Name="FormScroller" Grid.Column="0" TabIndex="0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <!-- At least as wide as the pane so ordinary boxes fill it, wider only if a memo
                         box was dragged out; that is what the horizontal bar is for. -->
                    <StackPanel Grid.IsSharedSizeScope="True" Margin="0,0,8,0"
                                MinWidth="{Binding ViewportWidth, ElementName=FormScroller}">
                        <TextBlock Text="{Binding EmptyText}" Opacity="0.8" Margin="0,4,0,8" TextWrapping="Wrap"
                                   Visibility="{Binding EmptyText, Converter={x:Static views:StringToVisibilityConverter.Instance}}" />

                        <Border Margin="0,0,0,8" Padding="8" CornerRadius="4"
                                Background="#22808080" BorderBrush="#44808080" BorderThickness="1"
                                Visibility="{Binding BatchFormFields.Count, Converter={x:Static views:CountToVisibilityConverter.Instance}}">
                            <StackPanel>
                                <TextBlock Text="Batch values — answered once for this group, stamped on every row"
                                           Opacity="0.7" Margin="0,0,0,6" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding BatchFormFields}"
                                              ItemTemplate="{StaticResource FormFieldTemplate}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding RowFormFields}"
                                      ItemTemplate="{StaticResource FormFieldTemplate}" />
                    </StackPanel>
                </ScrollViewer>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeWE"
                              DragCompleted="OnSplitterDragCompleted"
                              ToolTip="Drag to make the image bigger" />

                <DockPanel Grid.Column="2">
                    <WrapPanel x:Name="ZoomTools" DockPanel.Dock="Bottom" Margin="0,4,0,0"
                               KeyboardNavigation.TabIndex="1">
                        <Button Content="−" Click="OnZoomOut" Padding="12,2" Margin="0,0,4,0" ToolTip="Zoom out" />
                        <Button Content="+" Click="OnZoomIn" Padding="12,2" Margin="0,0,4,0" ToolTip="Zoom in" />
                        <Button Content="Fit" Click="OnFit" Padding="10,2" Margin="0,0,4,0" ToolTip="Show the whole page" />
                        <Button Content="100%" Click="OnActualSize" Padding="10,2" Margin="0,0,8,0" ToolTip="Actual size" />
                        <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Opacity="0.7" MinWidth="52" />
                    </WrapPanel>

                    <Border BorderBrush="Gray" BorderThickness="1">
                        <Grid>
                            <!-- Ctrl+wheel zooms; an ungated wheel would steal ordinary scrolling. -->
                            <ScrollViewer x:Name="ImageScroller"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="OnImageMouseWheel"
                                          ScrollChanged="OnImageScrollerScrollChanged">
                                <!-- LayoutTransform, not RenderTransform: the extent has to grow with
                                     the zoom or the scrollbars never reach the rest of the page. -->
                                <Image x:Name="PageImage" Stretch="None"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Source="{Binding SelectedRow.ImagePath, Converter={x:Static views:PreviewImageConverter.Instance}, NotifyOnTargetUpdated=True}"
                                       TargetUpdated="OnImageChanged">
                                    <Image.LayoutTransform>
                                        <ScaleTransform x:Name="PageScale" ScaleX="1" ScaleY="1" />
                                    </Image.LayoutTransform>
                                </Image>
                            </ScrollViewer>

                            <TextBlock x:Name="ImageMissingText" Visibility="Collapsed" Margin="12"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeNS"
                          DragCompleted="OnSplitterDragCompleted"
                          ToolTip="Drag to make the list of pages taller" />

            <!-- The same columns as the Groups grid, from the shared builder. Sorting stays off: the
                 form and the image page in Rows order, so a re-sort would make "next" mean two things. -->
            <DataGrid x:Name="EntryGrid" Grid.Row="2" TabIndex="2"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      EnableRowVirtualization="True"
                      SelectionUnit="FullRow" SelectionMode="Single">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Style.Triggers>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter Property="BorderBrush" Value="IndianRed" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="ToolTip"
                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
