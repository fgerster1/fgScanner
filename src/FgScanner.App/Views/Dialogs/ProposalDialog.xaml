<Window x:Class="FgScanner.App.Views.Dialogs.ProposalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FgScanner.App.Views"
        Title="Propose documents" Width="560" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        views:DialogFit.KeepOnScreen="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Every run, scrollable: the preview is the only check before permanent page ids are
             minted from this grouping, so none of it may be cut off (SPEC-2026-009 R2). -->
        <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Consolas" Margin="0,0,0,12" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ApplyButton" Content="Apply" MinWidth="80" Margin="0,0,6,0" Click="OnApply" />
            <!-- Cancel is the default: Enter pressed by habit must not regroup a box. -->
            <Button x:Name="CancelButton" Content="Cancel" IsDefault="True" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
