<Window x:Class="FgScanner.App.Views.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FgScanner.App.Views"
        Title="FG Scanner" SizeToContent="Height" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        views:DialogFit.KeepOnScreen="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Not focusable: clicking a label would otherwise take keyboard focus from the field in use. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBox x:Name="ValueBox" Margin="0,0,0,12" />
            </StackPanel>
        </ScrollViewer>
        <!-- After the body, so Tab reaches the fields before the buttons. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" MinWidth="80" Margin="0,0,6,0" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
