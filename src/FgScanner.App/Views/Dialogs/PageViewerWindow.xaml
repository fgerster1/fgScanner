<Window x:Class="FgScanner.App.Views.Dialogs.PageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Page viewer" Width="1000" Height="820"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        KeyDown="OnKeyDown">
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="FirstButton" Content="⏮ First" Click="OnFirst" Padding="10,4" Margin="0,0,4,0" ToolTip="Home" />
            <Button x:Name="PreviousButton" Content="◀ Previous" Click="OnPrevious" Padding="10,4" Margin="0,0,8,0" ToolTip="Left arrow" />
            <TextBlock x:Name="PositionText" VerticalAlignment="Center" MinWidth="110"
                       TextAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
            <Button x:Name="NextButton" Content="Next ▶" Click="OnNext" Padding="10,4" Margin="0,0,4,0" ToolTip="Right arrow" />
            <Button x:Name="LastButton" Content="Last ⏭" Click="OnLast" Padding="10,4" Margin="0,0,16,0" ToolTip="End" />

            <Button Content="−" Click="OnZoomOut" Padding="12,4" Margin="0,0,4,0" ToolTip="Zoom out (Ctrl+-)" />
            <Button Content="+" Click="OnZoomIn" Padding="12,4" Margin="0,0,4,0" ToolTip="Zoom in (Ctrl++)" />
            <Button Content="Fit" Click="OnFit" Padding="10,4" Margin="0,0,4,0" ToolTip="Show the whole page" />
            <Button Content="100%" Click="OnActualSize" Padding="10,4" Margin="0,0,8,0" ToolTip="Actual size (Ctrl+0)" />
            <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Opacity="0.7" MinWidth="52" />
        </WrapPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="FileNameText" VerticalAlignment="Center" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" />
            <Button Content="Close" IsCancel="True" Padding="14,4" HorizontalAlignment="Right"
                    DockPanel.Dock="Right" />
        </DockPanel>

        <!-- Ctrl+wheel zooms; an ungated wheel would steal ordinary scrolling. -->
        <Border BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer x:Name="Scroller"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="OnScrollerMouseWheel"
                          SizeChanged="OnScrollerSizeChanged">
                <!-- LayoutTransform, not RenderTransform: the ScrollViewer's extent has to grow
                     with the zoom or the scrollbars never reach the rest of the page. -->
                <Image x:Name="PageImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="PageScale" ScaleX="1" ScaleY="1" />
                    </Image.LayoutTransform>
                </Image>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
