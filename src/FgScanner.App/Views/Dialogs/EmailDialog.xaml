<Window x:Class="FgScanner.App.Views.Dialogs.EmailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FgScanner.App.Views"
        Title="Email pages" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        views:DialogFit.KeepOnScreen="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Not focusable: clicking a label would otherwise take keyboard focus from the field in use. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <!-- Says what is going before it goes: the count is the one thing that catches a
                     selection nobody meant, and it is the number §14 also writes to the log. -->
                <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />

                <!-- Shown once for a committed group on the Evidence profile (§05 Q2b). It sits in
                     this dialog rather than in one of its own: it is a thing to know, not a second
                     confirmation, and it never stops a send. -->
                <Border x:Name="EvidencePanel" Visibility="Collapsed"
                        BorderBrush="IndianRed" BorderThickness="1" CornerRadius="3"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="This group is a committed evidence record" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="What you send is a copy. It leaves the group folder, whose index, checksums and originals\ archive are what make it evidence — and once it has left, nothing here can account for it. The folder itself is not changed by sending." />
                        <CheckBox x:Name="DontWarnCheck" Margin="0,8,0,0" Content="I understand — don’t show this again" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Subject" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="SubjectBox" Margin="0,0,0,10" />

                <TextBlock Text="Attach as" FontWeight="SemiBold" Margin="0,0,0,2" />
                <ComboBox x:Name="FormatBox" SelectedIndex="0" Margin="0,0,0,4">
                    <ComboBoxItem Content="One PDF" />
                    <ComboBoxItem Content="Separate images" />
                </ComboBox>
                <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                           Text="A PDF is one file and opens anywhere. Separate images are the page files exactly as scanned, easier for a recipient to look at one at a time." />
            </StackPanel>
        </ScrollViewer>
        <!-- After the body, so Tab reaches the fields before the buttons. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Continue" IsDefault="True" MinWidth="90" Margin="0,0,6,0" Click="OnContinue"
                    ToolTip="Builds the attachments and opens a message. Nothing is sent until you press Send in your mail app." />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
